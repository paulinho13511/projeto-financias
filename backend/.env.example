# Copie para .env e preencha. Nunca commite o arquivo .env.

# Obrigatório: segredo para assinar os tokens (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta HTTP da API (padrão 3000)
PORT=3000

# Origens do front-end autorizadas a chamar a API, separadas por vírgula, sem barra final
ALLOWED_ORIGINS=https://seu-app.vercel.app

# Arquivo do banco SQLite (padrão: backend/data/financas.db).
# Em produção, aponte para um volume persistente, ex.: /data/financas.db
DB_FILE=./data/financas.db

# Duração do token de sessão (formato da lib ms, ex.: 8h, 12h, 7d)
JWT_EXPIRES_IN=8h

# true somente se a API estiver atrás de um proxy confiável (Railway, Fly, Nginx etc.)
TRUST_PROXY=false
